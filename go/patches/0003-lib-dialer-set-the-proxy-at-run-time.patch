From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 23:50:00 +0000
Subject: [PATCH] lib/dialer: set the proxy at run time

The proxy comes from all_proxy and ALL_PROXY_NO_FALLBACK, which are read
once per process (x/net/proxy caches the environment). An app that runs
the core in its own process cannot change the proxy without restarting
that process.

Add dialer.SetProxy, which replaces the proxy for later dials. Literal
loopback, private and link-local addresses are dialed directly, as they
never leave the local network. With no fallback, QUIC (UDP, which the
proxies do not carry; its listener also runs STUN) and NAT port mapping
(it announces the public address) are off, so nothing goes around the
proxy. Without SetProxy the environment applies as before.
---
diff --git a/lib/connections/proxyonly_test.go b/lib/connections/proxyonly_test.go
new file mode 100644
index 0000000..4d3a519
--- /dev/null
+++ b/lib/connections/proxyonly_test.go
@@ -0,0 +1,38 @@
+// Copyright (C) 2026 The Syncthing Authors.
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this file,
+// You can obtain one at https://mozilla.org/MPL/2.0/.
+
+package connections
+
+import (
+	"net/url"
+	"testing"
+
+	"github.com/syncthing/syncthing/lib/config"
+	"github.com/syncthing/syncthing/lib/dialer"
+)
+
+func TestQUICOffWhenProxyOnly(t *testing.T) {
+	t.Cleanup(func() { _ = dialer.SetProxy(nil, false) })
+	proxy := &url.URL{Scheme: "socks5", Host: "127.0.0.1:9050"}
+	for _, noFallback := range []bool{false, true} {
+		if err := dialer.SetProxy(proxy, noFallback); err != nil {
+			t.Fatal(err)
+		}
+		want := error(nil)
+		if noFallback {
+			want = errProxyOnly
+		}
+		if err := (quicDialerFactory{}).Valid(config.Configuration{}); err != want {
+			t.Errorf("noFallback %v: QUIC dialer %v, want %v", noFallback, err, want)
+		}
+		if err := (&quicListenerFactory{}).Valid(config.Configuration{}); err != want {
+			t.Errorf("noFallback %v: QUIC listener %v, want %v", noFallback, err, want)
+		}
+		if err := (tcpDialerFactory{}).Valid(config.Configuration{}); err != nil {
+			t.Errorf("noFallback %v: TCP dialer %v", noFallback, err)
+		}
+	}
+}
