@@ -0,0 +1,32 @@
+// Copyright (C) 2026 The Syncthing Authors.
+//
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this file,
+// You can obtain one at https://mozilla.org/MPL/2.0/.
+
+package nat
+
+import (
+	"net/url"
+	"testing"
+
+	"github.com/syncthing/syncthing/lib/config"
+	"github.com/syncthing/syncthing/lib/dialer"
+	"github.com/syncthing/syncthing/lib/protocol"
+)
+
+func TestNATOffWhenProxyOnly(t *testing.T) {
+	t.Cleanup(func() { _ = dialer.SetProxy(nil, false) })
+	on := config.Configuration{Options: config.OptionsConfiguration{NATEnabled: true}}
+	proxy := &url.URL{Scheme: "socks5", Host: "127.0.0.1:9050"}
+	for _, noFallback := range []bool{false, true} {
+		if err := dialer.SetProxy(proxy, noFallback); err != nil {
+			t.Fatal(err)
+		}
+		s := &Service{id: protocol.EmptyDeviceID, processScheduled: make(chan struct{}, 1)}
+		s.CommitConfiguration(on, on)
+		if s.enabled == noFallback {
+			t.Errorf("noFallback %v: NAT enabled %v", noFallback, s.enabled)
+		}
+	}
+}
