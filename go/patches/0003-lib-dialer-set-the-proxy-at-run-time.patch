index 112bc46..f797833 100644
--- a/lib/nat/service.go
+++ b/lib/nat/service.go
@@ -19,6 +19,7 @@ import (
 
 	"github.com/syncthing/syncthing/internal/slogutil"
 	"github.com/syncthing/syncthing/lib/config"
+	"github.com/syncthing/syncthing/lib/dialer"
 	"github.com/syncthing/syncthing/lib/protocol"
 )
 
@@ -46,12 +47,15 @@ func NewService(id protocol.DeviceID, cfg config.Wrapper) *Service {
 }
 
 func (s *Service) CommitConfiguration(_, to config.Configuration) bool {
+	// A port mapping would announce this device's public address, which a
+	// proxy that nothing may go around is meant to hide.
+	enabled := to.Options.NATEnabled && !dialer.NoFallback()
 	s.mut.Lock()
-	if !s.enabled && to.Options.NATEnabled {
+	if !s.enabled && enabled {
 		slog.Debug("Starting NAT service")
 		s.enabled = true
 		s.scheduleProcess()
-	} else if s.enabled && !to.Options.NATEnabled {
+	} else if s.enabled && !enabled {
 		slog.Debug("Stopping NAT service")
 		s.enabled = false
 	}
