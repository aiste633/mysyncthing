+// configWritesMiddleware counts the requests that may change the config, from the
+// moment they arrive, so that a listener restart can let them finish.
+func (s *service) configWritesMiddleware(h http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodGet && r.Method != http.MethodHead && r.Method != http.MethodOptions &&
+			(strings.HasPrefix(r.URL.Path, "/rest/config") || strings.HasPrefix(r.URL.Path, "/rest/system/config")) {
+			s.configWrites.add(1)
+			defer s.configWrites.add(-1)
+		}
+		h.ServeHTTP(w, r)
+	})
+}
+
+// inFlight counts requests being served. Unlike a sync.WaitGroup, requests may start
+// while someone waits, and are then waited for too.
+type inFlight struct {
+	mut  sync.Mutex
+	n    int
+	idle *sync.Cond
+}
+
+func newInFlight() *inFlight {
+	f := &inFlight{}
+	f.idle = sync.NewCond(&f.mut)
+	return f
+}
+
+func (f *inFlight) add(delta int) {
+	f.mut.Lock()
+	f.n += delta
+	if f.n == 0 {
+		f.idle.Broadcast()
+	}
+	f.mut.Unlock()
+}
+
+// wait returns once no request is being served.
+func (f *inFlight) wait() {
+	f.mut.Lock()
+	for f.n > 0 {
+		f.idle.Wait()
+	}
+	f.mut.Unlock()
+}
+
 func debugMiddleware(h http.Handler) http.Handler {
 	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
 		t0 := time.Now()
