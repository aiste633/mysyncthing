+// slowSave makes saving config.xml slower than the listener's shutdown timeout
+// (100 ms), and saving starts only once the expected number of changes has arrived.
+type slowSave struct {
+	config.Wrapper
+	delay   time.Duration
+	changes atomic.Int32
+	arrived chan struct{} // closed once changes reaches the expected number
+	expect  int32
+}
+
+func (w *slowSave) Modify(fn config.ModifyFunction) (config.Waiter, error) {
+	if w.changes.Add(1) == w.expect {
+		close(w.arrived)
+	}
+	return w.Wrapper.Modify(fn)
+}
+
+func (w *slowSave) Save() error {
+	select {
+	case <-w.arrived:
+	case <-time.After(10 * time.Second):
+	}
+	time.Sleep(w.delay)
+	return w.Wrapper.Save()
+}
+
+// startSlowSave starts the API on a real config whose saves take delay and wait for
+// the given number of changes.
+func startSlowSave(t *testing.T, delay time.Duration, changes int) (config.Wrapper, string) {
+	t.Helper()
+	cfg := config.Configuration{GUI: config.GUIConfiguration{RawAddress: "127.0.0.1:0", APIKey: testAPIKey}}
+	w := config.Wrap(filepath.Join(t.TempDir(), "config.xml"), cfg, protocol.LocalDeviceID, events.NoopLogger)
+	ctx, cancel := context.WithCancel(context.Background())
+	served := make(chan struct{})
+	go func() {
+		w.Serve(ctx)
+		close(served)
+	}()
+	// Serve saves once more when it stops, so it must stop before the temp dir goes.
+	t.Cleanup(func() {
+		cancel()
+		<-served
+	})
+	return w, startHTTP(t, &slowSave{Wrapper: w, delay: delay, arrived: make(chan struct{}), expect: int32(changes)})
+}
+
+func patchTheme(baseURL, theme string) error {
+	req, err := http.NewRequest(http.MethodPatch, baseURL+"/rest/config/gui", bytes.NewBufferString(`{"theme":"`+theme+`"}`))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("X-API-Key", testAPIKey)
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		return fmt.Errorf("no response to the GUI change: %w", err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("unexpected status %d", resp.StatusCode)
+	}
+	return nil
+}
+
+// A GUI setting change restarts the listener. The request that made the change must
+// still get its response, however long saving the config takes.
+func TestGUIChangeAnsweredDespiteSlowSave(t *testing.T) {
+	t.Parallel()
+
+	w, baseURL := startSlowSave(t, 300*time.Millisecond, 1)
+	if err := patchTheme(baseURL, "dark"); err != nil {
+		t.Fatal(err)
+	}
+	if w.GUI().Theme != "dark" {
+		t.Fatal("change not applied")
+	}
+	if _, err := os.Stat(w.ConfigPath()); err != nil {
+		t.Fatal("config not saved:", err)
+	}
+}
+
+// Concurrent GUI changes each get their response, and none waits on another's restart.
+func TestConcurrentGUIChangesAnswered(t *testing.T) {
+	t.Parallel()
+
+	themes := []string{"dark", "black", "light", "default"}
+	// All changes are in flight before the first one has saved, so before any restart.
+	_, baseURL := startSlowSave(t, 150*time.Millisecond, len(themes))
+	errs := make(chan error, len(themes))
+	for _, theme := range themes {
+		go func() { errs <- patchTheme(baseURL, theme) }()
+	}
+	for range themes {
+		select {
+		case err := <-errs:
+			if err != nil {
+				t.Error(err)
+			}
+		case <-time.After(10 * time.Second):
+			t.Fatal("GUI changes deadlocked")
+		}
+	}
+}
