From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 23:10:06 +0000
Subject: [PATCH] lib/api: restart the listener for a GUI change without the 
 supervisor

A change to the GUI settings ends Serve so that the listener restarts with
the new settings. The supervisor counts every return as a failure: after
more than 5 within about 30 s (suture's defaults, which the main supervisor
uses) it backs off for 15 s, and the GUI and API are unreachable that long.
Six GUI changes in a row, e.g. trying themes in the web GUI or a program
that sets GUI options one at a time, are enough.

Restart the listener inside Serve instead. A real failure (the listener
can't be opened, Serve fails) still returns to the supervisor.
---
 lib/api/api.go              | 16 ++++++++++++
 lib/api/api_restart_test.go | 44 ++++++++++++++++++++++++++++++++
 lib/api/api_test.go         | 50 +++++++++++++++++++++----------------
 3 files changed, 88 insertions(+), 22 deletions(-)

diff --git a/lib/api/api.go b/lib/api/api.go
index 1b6339f..6ee627e 100644
--- a/lib/api/api.go
+++ b/lib/api/api.go
@@ -218,7 +218,22 @@ func sendJSON(w http.ResponseWriter, jsonObject any) {
 	fmt.Fprintf(w, "%s\n", bs)
 }
 
+// errConfigChanged ends one run of serve so that the listener restarts with the new
+// GUI settings.
+var errConfigChanged = errors.New("GUI settings changed")
+
 func (s *service) Serve(ctx context.Context) error {
+	// A GUI change restarts the listener here, not through the supervisor: the
+	// supervisor counts every return as a failure and, after a few changes in a row,
+	// would back off and leave the GUI and API unreachable for a while.
+	for {
+		if err := s.serve(ctx); !errors.Is(err, errConfigChanged) {
+			return err
+		}
+	}
+}
+
+func (s *service) serve(ctx context.Context) error {
 	listener, err := s.getListener(s.cfg.GUI())
 	if err != nil {
 		select {
@@ -452,6 +467,7 @@ func (s *service) Serve(ctx context.Context) error {
 		// The request that made the change is still saving the config. Let it, and any
 		// other config change in flight, answer first, however long saving takes.
 		s.configWrites.wait()
+		err = errConfigChanged
 	case err = <-s.exitChan:
 	case err = <-serveError:
 		// Restart due to listen/serve failure
