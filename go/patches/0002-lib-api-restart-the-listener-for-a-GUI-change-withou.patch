+// Each GUI change restarts the listener. Under the core's supervisor (default
+// failure threshold 5, backoff 15 s) the GUI and API must stay reachable after many
+// changes in a row: the restarts are not failures.
+func TestRepeatedGUIChangesKeepAPIUp(t *testing.T) {
+	t.Parallel()
+
+	cfg := config.Configuration{GUI: config.GUIConfiguration{RawAddress: "127.0.0.1:0", APIKey: testAPIKey}}
+	w := config.Wrap(filepath.Join(t.TempDir(), "config.xml"), cfg, protocol.LocalDeviceID, events.NoopLogger)
+	ctx, cancel := context.WithCancel(context.Background())
+	served := make(chan struct{})
+	go func() {
+		w.Serve(ctx)
+		close(served)
+	}()
+	t.Cleanup(func() {
+		cancel()
+		<-served
+	})
+
+	started := make(chan string)
+	svc := newTestService(t, w)
+	svc.started = started
+	supervisor := suture.New("main", svcutil.SpecWithDebugLogger())
+	supervisor.Add(svc)
+	supervisor.ServeBackground(ctx)
+	baseURL := "http://" + <-started
+
+	themes := []string{"dark", "light"}
+	for i := range 10 {
+		if err := patchTheme(baseURL, themes[i%2]); err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case addr := <-started:
+			// The port is chosen anew on each restart.
+			baseURL = "http://" + addr
+		case <-time.After(5 * time.Second):
+			t.Fatalf("GUI and API not back 5 s after change %d", i+1)
+		}
+	}
+}
