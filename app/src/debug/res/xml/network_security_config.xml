<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the end-to-end test (androidTest e2e/Peer.kt) runs in the app's process and
     talks plain HTTP to its throwaway peer's API, forwarded to loopback. The app itself uses TLS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
