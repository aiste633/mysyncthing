<?xml version="1.0" encoding="utf-8"?>
<!-- The app's own HTTP goes only to the core's REST API/GUI on loopback, over TLS with the
     core's own certificate pinned (core/CoreCertificate.kt): no cleartext anywhere. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
