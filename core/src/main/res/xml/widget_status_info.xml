<?xml version="1.0" encoding="utf-8"?>
<!-- Full width x 1, fixed size like the search bar: 5 cells where the grid has them, else every column
     (minWidth fills a 4-column grid). Updated by the service on state changes, never on a timer. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_status"
    android:minWidth="290dp"
    android:minHeight="40dp"
    android:previewLayout="@layout/widget_status"
    android:resizeMode="none"
    android:targetCellWidth="5"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
