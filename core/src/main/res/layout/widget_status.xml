<?xml version="1.0" encoding="utf-8"?>
<!-- A bar the height of the search bar, centred in its cell however tall the launcher's rows are:
     status icon, two lines of text, pause button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/widget_status_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ic_stopped" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_name"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_button"
        android:layout_width="40dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_button_bg"
        android:contentDescription="@string/widget_pause"
        android:scaleType="center"
        android:src="@drawable/widget_ic_pause"
        android:tint="@color/widget_button_icon" />
</LinearLayout>
</FrameLayout>
